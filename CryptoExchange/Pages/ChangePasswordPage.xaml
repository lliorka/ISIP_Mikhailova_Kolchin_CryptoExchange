<Page x:Class="CryptoExchange.Pages.ChangePasswordPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Border Background="{DynamicResource PanelBrush}" Padding="24" Width="500" Height="430" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
 <TextBlock Text="Смена пароля" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
 <TextBlock Text="Логин"/><TextBox x:Name="LoginBox"/>
 <TextBlock Text="Текущий пароль"/><PasswordBox x:Name="OldBox"/>
 <TextBlock Text="Новый пароль"/><PasswordBox x:Name="NewBox"/>
 <TextBlock Text="Повтор нового пароля"/><PasswordBox x:Name="ConfirmBox"/>
 <Button Content="Сохранить новый пароль" Click="Save_Click"/><Button Content="Назад" Click="Back_Click"/>
 </StackPanel></Border></Grid></Page>