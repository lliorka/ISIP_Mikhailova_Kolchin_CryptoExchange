<Page x:Class="CryptoExchange.Pages.AuthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
    <Grid>
        <Border CornerRadius="14" Padding="28" Width="470" Height="470" HorizontalAlignment="Center" VerticalAlignment="Center">
  <StackPanel><TextBlock Text="CRYPTOEXCHANGE" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Вход в учебную платформу" HorizontalAlignment="Center"/>
   <TextBlock Text="Логин"/><TextBox x:Name="LoginBox" ToolTip="Введите логин" />
   <TextBlock Text="Пароль"/><PasswordBox x:Name="PasswordBox" ToolTip="Введите пароль"/>
   <TextBlock x:Name="CaptchaText" FontSize="20" FontWeight="Bold" Foreground="#E85D75" HorizontalAlignment="Center" Visibility="Collapsed"/>
   <TextBox x:Name="CaptchaBox" ToolTip="Введите символы с картинки" Visibility="Collapsed"/>
   <Button Content="Войти" Click="Login_Click"/><Button Content="Регистрация" Click="Register_Click"/>
   <Button Content="Сменить пароль" Click="Change_Click"/>
   <TextBlock Text="После трёх неверных попыток потребуется капча." FontSize="11" Opacity=".75" TextWrapping="Wrap"/>
  </StackPanel>
 </Border></Grid></Page>