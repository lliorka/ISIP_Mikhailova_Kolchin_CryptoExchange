<Page x:Class="CryptoExchange.Pages.AdminPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel><TextBlock Text="Панель администратора" FontSize="22" FontWeight="Bold" DockPanel.Dock="Left"/>
 <ComboBox x:Name="TableBox" Width="210" SelectionChanged="Table_Changed" SelectedIndex="0"><ComboBoxItem Content="Пользователи"/><ComboBoxItem Content="Активы"/><ComboBoxItem Content="Курсы обмена"/><ComboBoxItem Content="Кошельки"/><ComboBoxItem Content="Заявки обмена"/><ComboBoxItem Content="Операции"/><ComboBoxItem Content="Движения кошельков"/><ComboBoxItem Content="Журнал аудита"/></ComboBox>
 <TextBox x:Name="SearchBox" Width="220" ToolTip="Поиск по отображаемым данным" TextChanged="Search_Changed"/></DockPanel>
 <DataGrid x:Name="AdminGrid" Grid.Row="1" CanUserAddRows="True" AutoGenerateColumns="True" SelectionMode="Extended"/>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Обновить" Click="Refresh_Click"/><Button Content="Сохранить изменения" Click="Save_Click"/><Button Content="Удалить выбранное" Click="Delete_Click"/><Button Content="Диаграммы и отчёты" Click="Charts_Click"/></StackPanel>
 </Grid></Page>