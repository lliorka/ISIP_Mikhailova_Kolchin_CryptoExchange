<Page x:Class="CryptoExchange.Pages.ChartPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="Аналитика заявок по статусам" FontSize="24" FontWeight="Bold"/>
 <Canvas x:Name="ChartCanvas" Grid.Row="1" Background="{DynamicResource PanelBrush}" Margin="8"/>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Обновить диаграмму" Click="Refresh_Click"/><Button Content="Назад" Click="Back_Click"/></StackPanel>
 </Grid></Page>