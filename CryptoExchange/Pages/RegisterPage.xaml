<Page x:Class="CryptoExchange.Pages.RegisterPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Border Background="{DynamicResource PanelBrush}" Padding="24" Width="540" Height="570" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
 <TextBlock Text="Создание учётной записи" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
 <TextBlock Text="Логин"/><TextBox x:Name="LoginBox" ToolTip="Уникальный логин"/>
 <TextBlock Text="Электронная почта"/><TextBox x:Name="EmailBox" ToolTip="name@example.com"/>
 <TextBlock Text="ФИО"/><TextBox x:Name="FioBox" ToolTip="Фамилия Имя Отчество"/>
 <TextBlock Text="Пароль"/><PasswordBox x:Name="PassBox" ToolTip="Минимум 8 символов, латиница, цифра и заглавная буква"/>
 <TextBlock Text="Повторите пароль"/><PasswordBox x:Name="ConfirmBox"/>
 <TextBlock Text="Роль"/><ComboBox x:Name="RoleBox"><ComboBoxItem Content="User" IsSelected="True"/><ComboBoxItem Content="Admin"/></ComboBox>
 <Button Content="Зарегистрироваться" Click="Save_Click"/><Button Content="Назад ко входу" Click="Back_Click"/>
 </StackPanel></Border></Grid></Page>