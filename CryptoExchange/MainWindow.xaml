<Window x:Class="CryptoExchange.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="CryptoExchange — учебная платформа" Height="760" Width="1180" MinHeight="620" MinWidth="900" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Background="{DynamicResource PanelBrush}">
   <Button Content="← Назад" Click="Back_Click" DockPanel.Dock="Left"/>
   <TextBlock x:Name="PageTitle" Text="Авторизация" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
    <Button Content="Светлая тема" Click="LightTheme_Click"/>
    <Button Content="Тёмная тема" Click="DarkTheme_Click"/>
    <Button Content="Выйти" Click="Logout_Click"/>
   </StackPanel>
  </DockPanel>
  <Frame x:Name="MainFrame" Background="{DynamicResource BgBrush}" Grid.Row="1" NavigationUIVisibility="Hidden"/>
  <DockPanel Grid.Row="2" Background="{DynamicResource PanelBrush}">
   <TextBlock Text="CryptoExchange • учебный проект УП.01.01" DockPanel.Dock="Left"/>
   <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right"/>
  </DockPanel>
 </Grid>
</Window>