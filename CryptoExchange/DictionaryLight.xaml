<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="BgBrush" Color="#F2F5F9"/><SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#246BCE"/><SolidColorBrush x:Key="TextBrush" Color="#172338"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Open Sans"/><Setter Property="Background" Value="{DynamicResource BgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
 <Style TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="10,5"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="7,4"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="6"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="6"/></Style>
 <Style TargetType="DataGrid"><Setter Property="Margin" Value="6"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Foreground" Value="#172338"/></Style>
 <Style TargetType="TextBlock"><Setter Property="Margin" Value="5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
</ResourceDictionary>